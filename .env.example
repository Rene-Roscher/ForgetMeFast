# In Produktion: APP_ENV=production und APP_DEBUG=false. Debug-Seiten zeigen Request-Daten.
APP_NAME=ForgetMeFast
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Hinter einem Reverse Proxy (nginx, Caddy, Traefik): dessen Adresse(n) oder CIDR-Bereiche, kommagetrennt. Ohne Angabe sieht die App
# nur die Adresse des Proxys, und alle Besucher teilen sich ein Throttle-Kontingent. Nur Adressen eintragen, die ihr kontrolliert.
TRUSTED_PROXIES=

CACHE_STORE=database
# CACHE_PREFIX=

# Inertia DevTools zeichnet Requests auf Platte auf; hier nie aktivieren (siehe docs/specs/privacy.md).
INERTIA_DEVTOOLS_ENABLED=false
INERTIA_SSR_ENABLED=false
